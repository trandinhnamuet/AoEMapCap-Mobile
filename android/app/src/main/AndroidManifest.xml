<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- cập nhật một chạm: app tự tải APK bản mới từ trang phát hành của mình rồi cài đè (Android vẫn kiểm chữ ký) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- usesCleartextTraffic: máy chủ trên máy tính trong mạng nhà chỉ có http -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="AoE-MapCap"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- trang của máy tính mở trong trình duyệt -> nút "Mở trong app": aoemapcap://pair?a=<ip:cổng/mã> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aoemapcap" android:host="pair" />
            </intent-filter>
        </activity>
        <receiver android:name=".MainActivity$UpdateReceiver" android:exported="false" />
        <!-- tải sẵn mô-đun máy quét QR khi cài app (không phải chờ lúc bấm Quét lần đầu) -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
    </application>
</manifest>
